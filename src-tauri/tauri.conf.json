{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiteFingerprint",
  "mainBinaryName": "LiteFingerprint",
  "version": "0.2.0",
  "identifier": "com.litefingerprint.client",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "externalBin": ["binaries/fb"],
    "shortDescription": "轻量指纹浏览器",
    "longDescription": "复用本机 Chrome/Edge 的轻量指纹浏览器：独立环境、指纹伪装、独立代理。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
